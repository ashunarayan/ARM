\@writefile{lot}{\contentsline {table}{\numberline {II}{\ignorespaces Simulator variants: LightGBM trained only on simulated drives (zero-shot), tested on the held-out real routes. Pooled segment MAE and bias in m/km; level: mean log(prediction/label) over the segments of a road class (0.10 is about 10\,\% over-prediction); within-route Spearman $\rho $. Right: pooled MAE with 5 or 20\,km of paired drives (about ten passes per segment) used for a level offset (2.5--97.5\,\% range over the 20 draws in brackets) or for joint training; means over 20 draws. Real-only LightGBM on the same drives: 0.68\,m/km (5\,km), 0.46\,m/km (20\,km). Class E except V0. Scale $b$ and speed elasticities: Table~\ref {S-tab:variants_s_gbm}.}}{6}{table.2}\protected@file@percent }
\newlabel{tab:variants}{{II}{6}{Simulator variants: LightGBM trained only on simulated drives (zero-shot), tested on the held-out real routes. Pooled segment MAE and bias in m/km; level: mean log(prediction/label) over the segments of a road class (0.10 is about 10\,\% over-prediction); within-route Spearman $\rho $. Right: pooled MAE with 5 or 20\,km of paired drives (about ten passes per segment) used for a level offset (2.5--97.5\,\% range over the 20 draws in brackets) or for joint training; means over 20 draws. Real-only LightGBM on the same drives: \vbRealOnlyFive \,m/km (5\,km), \vbRealOnlyTwenty \,m/km (20\,km). Class E except V0. Scale $b$ and speed elasticities: Table~\ref {S-tab:variants_s_gbm}}{table.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Simulator variants, LightGBM trained on simulated drives only and tested on the held-out real routes. (a) Within-route Spearman $\rho $ (real-trained model in blue; dashed: the untrained statistic RMS$/v^{0.5}$). (b) Zero-shot level (mean log ratio of prediction to label) on urban and motorway segments. (c) Pooled segment MAE zero-shot (open circles) and with 5\,km of paired drives used for a level offset (filled circles) or joint training (triangles), means over 20 draws; lines: real-trained on all training routes (solid) or on the 5\,km only (dashed).}}{6}{figure.2}\protected@file@percent }
\newlabel{fig:variants}{{2}{6}{Simulator variants, LightGBM trained on simulated drives only and tested on the held-out real routes. (a) Within-route Spearman $\rho $ (real-trained model in blue; dashed: the untrained statistic RMS$/v^{0.5}$). (b) Zero-shot level (mean log ratio of prediction to label) on urban and motorway segments. (c) Pooled segment MAE zero-shot (open circles) and with 5\,km of paired drives used for a level offset (filled circles) or joint training (triangles), means over 20 draws; lines: real-trained on all training routes (solid) or on the 5\,km only (dashed)}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces (a) Mean difference of log$_{10}$ power spectral density, real minus simulated, on the same segments in the same 10\,km/h speed bands (re-simulated passes of four sensor variants and the ideal sensor; bands: 95\,\% intervals from a 1\,km-block bootstrap). (b) Zero-shot bias of the nine measured-profile variants against the real/simulated amplitude ratio of the 10--15\,Hz band (log$_{10}$; diamond: V4, one vehicle), with the Spearman correlation of the bias with the ratio of every band. (c) Mean zero-shot level of each variant with all 13 features (open) and retrained on the five features without content above 10\,Hz (filled).}}{7}{figure.3}\protected@file@percent }
\newlabel{fig:spectra}{{3}{7}{(a) Mean difference of log$_{10}$ power spectral density, real minus simulated, on the same segments in the same 10\,km/h speed bands (re-simulated passes of four sensor variants and the ideal sensor; bands: 95\,\% intervals from a 1\,km-block bootstrap). (b) Zero-shot bias of the nine measured-profile variants against the real/simulated amplitude ratio of the 10--15\,Hz band (log$_{10}$; diamond: V4, one vehicle), with the Spearman correlation of the bias with the ratio of every band. (c) Mean zero-shot level of each variant with all 13 features (open) and retrained on the five features without content above 10\,Hz (filled)}{figure.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {V-D}}How much paired real data is needed}{7}{subsection.5.4}\protected@file@percent }
\newlabel{sec:res_value}{{\mbox  {V-D}}{7}{How much paired real data is needed}{subsection.5.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Simulation against paired real drives on the same 20 draws of $k$\,km of training-route road (pooled segment MAE on the held-out routes, means over draws; bold: V0, thin: V1--V8). Blue: real-only LightGBM (band: 2.5--97.5\,\% of draws) or vibration index (dashed). (a) Equal profile budget: LightGBM on simulated passes over the profiles of the same $k$\,km. (b) Simulation over all training-route profiles combined with the paired passes by a level offset (green) or joint training (pink); real-only values at 1 and 2\,km lie above the axis (LightGBM 1.63{} and 1.14, index 1.30{} and 0.94\,m/km).}}{8}{figure.4}\protected@file@percent }
\newlabel{fig:value}{{4}{8}{Simulation against paired real drives on the same 20 draws of $k$\,km of training-route road (pooled segment MAE on the held-out routes, means over draws; bold: V0, thin: V1--V8). Blue: real-only LightGBM (band: 2.5--97.5\,\% of draws) or vibration index (dashed). (a) Equal profile budget: LightGBM on simulated passes over the profiles of the same $k$\,km. (b) Simulation over all training-route profiles combined with the paired passes by a level offset (green) or joint training (pink); real-only values at 1 and 2\,km lie above the axis (LightGBM \vbRealOnlyOne {} and \vbRealOnlyTwo , index \vbRealIdxOne {} and \vbRealIdxTwo \,m/km)}{figure.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {III}{\ignorespaces Simulation and paired real drives on the same 20 draws of $k$\,km of training-route road, each with all real passes over it (passes: mean number of segment-passes). Pooled MAE over all segments of the held-out routes (brackets: 2.5--97.5\,\% of draws) and within-route MAE (mean of the four route MAEs), in m/km. Real-only: LightGBM or the three-parameter vibration index on the paired passes. Equal profile budget: LightGBM on V0 simulated passes over the profiles of the same $k$\,km (difference to real-only LightGBM; draws in which simulation was better). All profiles: simulation over all training-route profiles combined with the paired passes; ranges over V0--V8 of the means, and of the number of draws in which joint training beat real-only LightGBM.}}{8}{table.3}\protected@file@percent }
\newlabel{tab:value}{{III}{8}{Simulation and paired real drives on the same 20 draws of $k$\,km of training-route road, each with all real passes over it (passes: mean number of segment-passes). Pooled MAE over all segments of the held-out routes (brackets: 2.5--97.5\,\% of draws) and within-route MAE (mean of the four route MAEs), in m/km. Real-only: LightGBM or the three-parameter vibration index on the paired passes. Equal profile budget: LightGBM on V0 simulated passes over the profiles of the same $k$\,km (difference to real-only LightGBM; draws in which simulation was better). All profiles: simulation over all training-route profiles combined with the paired passes; ranges over V0--V8 of the means, and of the number of draws in which joint training beat real-only LightGBM}{table.3}{}}
