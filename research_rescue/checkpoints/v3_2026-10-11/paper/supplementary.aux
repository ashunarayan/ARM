\@writefile{lot}{\contentsline {table}{\numberline {S25}{\ignorespaces Speed elasticity of each estimate on a fixed road: slope of log(prediction) on log(speed) with segment fixed effects (segments with $\ge $3 passes), 95\,\% CI by 1\,km-block bootstrap; ``between'': design with route effects and log IRI as covariate. $|$elasticity$|\le $0.104 corresponds to the $\pm $10\,\% criterion over 40--100\,km/h. Last column: paired difference to the real-trained estimator of the same family (LightGBM or index) on the same passes, 95\,\% CI by 5\,km-block bootstrap (pooled).}}{15}{table.25}\protected@file@percent }
\newlabel{tab:s_speed}{{S25}{15}{Speed elasticity of each estimate on a fixed road: slope of log(prediction) on log(speed) with segment fixed effects (segments with $\ge $3 passes), 95\,\% CI by 1\,km-block bootstrap; ``between'': design with route effects and log IRI as covariate. $|$elasticity$|\le $0.104 corresponds to the $\pm $10\,\% criterion over 40--100\,km/h. Last column: paired difference to the real-trained estimator of the same family (LightGBM or index) on the same passes, 95\,\% CI by 5\,km-block bootstrap (pooled)}{table.25}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S26}{\ignorespaces Robustness of the fixed-road speed elasticities: (a) design of the main paper; (b) with telematics-unit fixed effects (point estimate); (c) with the log within-pass speed SD as a covariate; (d) with the speed coefficient of variation as a covariate, which is mechanically tied to $1/v$ (within-segment correlation with log speed \ensuremath  {-}0.86{} on urban roads) and absorbs most of the within-segment speed variation. 95\,\% intervals from 5\,km blocks. Within urban segments, log speed and log speed SD correlate at \ensuremath  {-}0.50: slow urban passes are more dynamic.}}{15}{table.26}\protected@file@percent }
\newlabel{tab:s_speed_rob}{{S26}{15}{Robustness of the fixed-road speed elasticities: (a) design of the main paper; (b) with telematics-unit fixed effects (point estimate); (c) with the log within-pass speed SD as a covariate; (d) with the speed coefficient of variation as a covariate, which is mechanically tied to $1/v$ (within-segment correlation with log speed \srCorrCvUrban {} on urban roads) and absorbs most of the within-segment speed variation. 95\,\% intervals from 5\,km blocks. Within urban segments, log speed and log speed SD correlate at \srCorrLsdUrban : slow urban passes are more dynamic}{table.26}{}}
