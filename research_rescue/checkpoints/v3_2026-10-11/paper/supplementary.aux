\@writefile{lot}{\contentsline {table}{\numberline {S16}{\ignorespaces Every measured-profile simulator variant against LightGBM trained on the real passes over the same $k$\,km (20 paired draws of training-route blocks). Entries: mean difference in pooled segment MAE, simulation arm minus real-only (m/km; negative = simulation better), and in parentheses the number of the 20 draws in which the simulation arm was better. ``Same $k$\,km'': trained on simulated passes over the profiles of the same blocks only (equal profile budget; V1--V8 added after the V0 result was known, class E). ``All profiles + level'': trained on all training-route profiles, level offset from the $k$\,km of real passes. ``+ affine'': affine calibration instead of the offset.}}{11}{table.16}\protected@file@percent }
\newlabel{tab:s_value_variants}{{S16}{11}{Every measured-profile simulator variant against LightGBM trained on the real passes over the same $k$\,km (20 paired draws of training-route blocks). Entries: mean difference in pooled segment MAE, simulation arm minus real-only (m/km; negative = simulation better), and in parentheses the number of the 20 draws in which the simulation arm was better. ``Same $k$\,km'': trained on simulated passes over the profiles of the same blocks only (equal profile budget; V1--V8 added after the V0 result was known, class E). ``All profiles + level'': trained on all training-route profiles, level offset from the $k$\,km of real passes. ``+ affine'': affine calibration instead of the offset}{table.16}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S17}{\ignorespaces Every simulator variant combined with $k$\,km of paired drives through an affine map (fitted on the paired passes) or by joint training (simulated units and paired passes, equal total weight), against real-only LightGBM on the same passes (20 paired draws). Entries: mean difference in pooled segment MAE (m/km; negative = simulation better) and, in parentheses, the number of draws in which simulation was better. Last row: pooled MAE of a no-simulator index $\log \mathrm  {IRI} = c + b\log (\mathrm  {RMS}/v^{\alpha })$ with $\alpha $ the car's label-free within-segment speed exponent (0.59--0.72), affine-calibrated on the same passes.}}{11}{table.17}\protected@file@percent }
\newlabel{tab:s_value_more}{{S17}{11}{Every simulator variant combined with $k$\,km of paired drives through an affine map (fitted on the paired passes) or by joint training (simulated units and paired passes, equal total weight), against real-only LightGBM on the same passes (20 paired draws). Entries: mean difference in pooled segment MAE (m/km; negative = simulation better) and, in parentheses, the number of draws in which simulation was better. Last row: pooled MAE of a no-simulator index $\log \mathrm {IRI} = c + b\log (\mathrm {RMS}/v^{\alpha })$ with $\alpha $ the car's label-free within-segment speed exponent (\nsAlphaCarMin --\nsAlphaCarMax ), affine-calibrated on the same passes}{table.17}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S18}{\ignorespaces Test-route uncertainty of the calibration comparison: mean over the 20 draws of the pooled-MAE difference to real-only LightGBM on the same $k$\,km (m/km), with a 95\,\% interval from a bootstrap over 5\,km blocks of the test segments (40{} blocks). The interval conditions on the 20 calibration draws.}}{11}{table.18}\protected@file@percent }
\newlabel{tab:s_calib_unc}{{S18}{11}{Test-route uncertainty of the calibration comparison: mean over the 20 draws of the pooled-MAE difference to real-only LightGBM on the same $k$\,km (m/km), with a 95\,\% interval from a bootstrap over 5\,km blocks of the test segments (\cuBlocks {} blocks). The interval conditions on the 20 calibration draws}{table.18}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S19}{\ignorespaces Pass density of the paired data at $k=5$\,km: each segment keeps at most $m$ of its real passes (random, independent of the labels; 20 draws). Pooled MAE in m/km; for the simulation arms the range over V0--V8 and, in parentheses, the range over the variants of the number of draws in which the arm beat real-only LightGBM with the same passes.}}{12}{table.19}\protected@file@percent }
\newlabel{tab:s_pass_density}{{S19}{12}{Pass density of the paired data at $k=5$\,km: each segment keeps at most $m$ of its real passes (random, independent of the labels; 20 draws). Pooled MAE in m/km; for the simulation arms the range over V0--V8 and, in parentheses, the range over the variants of the number of draws in which the arm beat real-only LightGBM with the same passes}{table.19}{}}
